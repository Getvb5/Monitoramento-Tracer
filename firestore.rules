rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthorizedAuditor(data) {
      return data.auditorId == request.auth.uid || data.auditorId == 'SYSTEM_SYNC';
    }

    // Audits - Hand Hygiene
    match /audits_hand_hygiene/{id} {
      allow read, write: if isSignedIn();
    }

    // Audits - Patient ID
    match /audits_patient_id/{id} {
      allow read, write: if isSignedIn();
    }

    // Audits - Safe Surgery
    match /audits_safe_surgery/{id} {
      allow read, write: if isSignedIn();
    }

    // Escalas OSS
    match /escalas_oss/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAuthorizedAuditor(request.resource.data);
    }

    // Units
    match /units/{id} {
      allow read: if isSignedIn();
      allow write: if false; // Only admins via console for now
    }

    // Auditors
    match /auditors/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && id == request.auth.uid;
    }

    // Test connectivity
    match /test/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
